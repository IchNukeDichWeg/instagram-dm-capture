{
  "manifest_version": 3,
  "name": "Instagram DM Capture",
  "version": "1.0.0",
  "description": "Capture Instagram DM messages from the page's own network traffic and export them as JSON.",
  "permissions": ["storage", "unlimitedStorage", "downloads"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Instagram DM Capture" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
