{
  "manifest_version": 3,
  "name": "Instagram DM Capture",
  "version": "1.1.0",
  "description": "Capture Instagram DM messages from the page's own network traffic and export them as JSON.",
  "permissions": ["storage", "unlimitedStorage", "downloads", "offscreen"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Instagram DM Capture",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
